# ============================================================
# SafeStep — Variables de entorno
# En Dokploy: pega cada variable en la sección Environment Variables.
# ============================================================

# ── Base de datos ────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=CambiaEstePassword123!
DB_NAME=postgres

# ── URL del sitio (REQUERIDO — corrige links en header/footer/emails) ──
EVERSHOP_HOME_URL=https://aresafestep.com

# ── Admin del panel ──────────────────────────────────────────
# Se crea automáticamente en cada deploy si no existe.
ADMIN_EMAIL=admin@aresafestep.com
ADMIN_PASSWORD=OtraClaveSegura456!
ADMIN_NAME=Administrador

# ── GoHighLevel (formulario de contacto) ─────────────────────
GHL_LOCATION_ID=tu_location_id_aqui
GHL_API_KEY=tu_api_key_aqui

# ── Square (método de pago) ──────────────────────────────────
# 'sandbox' para pruebas, 'production' para cobros reales.
SQUARE_ENVIRONMENT=sandbox
# Públicas (se usan en el formulario de tarjeta del checkout):
SQUARE_APPLICATION_ID=tu_square_application_id
SQUARE_LOCATION_ID=tu_square_location_id
# SECRETA (solo backend — NUNCA se guarda en la base de datos):
SQUARE_ACCESS_TOKEN=tu_square_access_token
# Opcional (verificación de webhooks, a futuro):
SQUARE_WEBHOOK_SIGNATURE_KEY=
